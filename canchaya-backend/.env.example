# Variables de Entorno de Ejemplo para CanchaYA Backend

# Puerto donde correrá el servidor HTTP
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=production

# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_segura
DB_NAME=canchaya_db

# Seguridad JWT
JWT_SECRET=CambiarEstaClaveSecretaEnProduccionPorUnaMasLargaYCompleja

# Configuración de CORS (Origen permitido para peticiones del Frontend)
CORS_ORIGIN=*
